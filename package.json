{
  "name": "agent-orchestration-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Runnable examples of agent orchestration patterns in TypeScript (Vercel AI SDK + LangGraph.js + OpenRouter)",
  "scripts": {
    "01": "tsx --env-file=.env.local src/01-single-agent.ts",
    "02": "tsx --env-file=.env.local src/02-prompt-chain.ts",
    "03": "tsx --env-file=.env.local src/03-router.ts",
    "04": "tsx --env-file=.env.local src/04-parallel.ts",
    "05": "tsx --env-file=.env.local src/05-orchestrator-workers.ts",
    "06": "tsx --env-file=.env.local src/06-evaluator-optimizer.ts",
    "07": "tsx --env-file=.env.local src/07-supervisor-handoff.ts",
    "08": "tsx --env-file=.env.local src/08-langgraph-supervisor.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@langchain/core": "^1.3.5",
    "@langchain/langgraph": "^1.7.2",
    "@langchain/openai": "^1.8.2",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.164",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.6"
  }
}
